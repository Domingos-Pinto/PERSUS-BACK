                    "200": {
                        "description": "Dados do utilizador"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Atualiza dados do utilizador autenticado",
                "operationId": "06413be601a549a2ed2f8e5c9f4268e5",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Domingos Pinto"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "novo@teste.com"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "959697513"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Dados atualizados"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/users/{user}/block": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Bloqueia um utilizador (apenas admin)",
                "operationId": "3f4ea7d59a0b4e0b02fa1a88545e60c3",
                "parameters": [
                    {
                        "name": "user",
                        "in": "path",
                        "description": "ID do utilizador a bloquear",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Utilizador bloqueado"
                    },
                    "403": {
                        "description": "Sem permissão"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/users/{user}/unblock": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Desbloqueia um utilizador (apenas admin)",
                "operationId": "ec4fafcfff32ad15af7a97b5d2e79742",
                "parameters": [
                    {
                        "name": "user",
                        "in": "path",
                        "description": "ID do utilizador a desbloquear",
                        "required": true,
                        "schema": {
                            "type": "integer"
